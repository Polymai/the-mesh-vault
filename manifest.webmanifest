{
  "name": "TheMeshVault",
  "short_name": "MeshVault",
  "description": "Private, resilient storage across verified devices.",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "background_color": "#02060b",
  "theme_color": "#02060b",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/pdf",
            "application/zip",
            "application/gzip",
            "application/octet-stream",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".ppt",
            ".pptx",
            ".7z"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Take photo into vault",
      "short_name": "Take photo",
      "description": "Open TheMeshVault camera intake.",
      "url": "./#/drive?camera=1",
      "icons": [
        { "src": "assets/camera-shortcut.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    }
  ],
  "icons": [
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
